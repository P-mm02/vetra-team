# Copy to .env.local. Keep real credentials out of Git.
MONGODB_URI=mongodb://127.0.0.1:27017/vetra-team
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enable first-user setup temporarily, then remove this token.
CMS_BOOTSTRAP_TOKEN=
# Existing portfolio images are hosted on Cloudinary and render without API keys.
# New CMS uploads require all three values from the same Cloudinary account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required on Vercel for the authenticated daily Trash expiry job.
CRON_SECRET=
# Payment requests can be recorded with payments disabled. Checkout requires all
# Stripe values below plus a valid NEXT_PUBLIC_SITE_URL.
PAYMENTS_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional analytics
NEXT_PUBLIC_GA_ID=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
